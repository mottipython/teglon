#!/bin/sh
# Switch the Teglon screensaver on or off for this desktop session.
#
# Wayland desktops have no screensaver service to plug into, so this starts a small
# idle watcher (swayidle) at login that runs teglon once the session has been idle
# for the given time. Any key or mouse movement ends it.
# Works on compositors with the ext-idle-notify protocol: KDE Plasma, Sway,
# Hyprland, niri, COSMIC, labwc, river and others. GNOME does not provide it.

set -e
AUTOSTART="${XDG_CONFIG_HOME:-$HOME/.config}/autostart/teglon-screensaver.desktop"

usage() {
    echo "usage: teglon-screensaver enable [MINUTES]   start after MINUTES idle (default 5)"
    echo "       teglon-screensaver disable"
    echo "       teglon-screensaver status"
    echo "       teglon-screensaver now                run it right away"
    exit 1
}

stop_watcher() {
    pkill -u "$(id -u)" -f '^swayidle .*timeout [0-9]+ teglon$' 2>/dev/null || true
}

case "${1:-}" in
enable)
    minutes="${2:-5}"
    case "$minutes" in ''|*[!0-9]*) usage ;; esac
    [ "$minutes" -ge 1 ] || usage
    if ! command -v swayidle >/dev/null 2>&1; then
        echo "swayidle is not installed. Install it first (dnf install swayidle / apt install swayidle)." >&2
        exit 1
    fi
    if [ -z "${WAYLAND_DISPLAY:-}" ]; then
        echo "This is not a Wayland session. On X11, add teglon to xscreensaver or your desktop's own idle settings." >&2
        exit 1
    fi
    seconds=$((minutes * 60))
    mkdir -p "$(dirname "$AUTOSTART")"
    cat > "$AUTOSTART" <<EOF
[Desktop Entry]
Type=Application
Name=Teglon screensaver
Comment=Run the Teglon screensaver after $minutes minutes idle
Exec=swayidle -w timeout $seconds teglon
X-GNOME-Autostart-enabled=true
NoDisplay=true
EOF
    stop_watcher
    setsid swayidle -w timeout "$seconds" teglon >/dev/null 2>&1 &
    echo "Teglon screensaver enabled: starts after $minutes minutes idle, now and at every login."
    ;;
disable)
    rm -f "$AUTOSTART"
    stop_watcher
    echo "Teglon screensaver disabled."
    ;;
status)
    if [ -f "$AUTOSTART" ]; then
        grep '^Comment=' "$AUTOSTART" | cut -d= -f2-
        if pgrep -u "$(id -u)" -f '^swayidle .*timeout [0-9]+ teglon$' >/dev/null 2>&1; then echo "Idle watcher is running."; else echo "Idle watcher is not running (it starts at login)."; fi
    else
        echo "Teglon screensaver is disabled."
    fi
    ;;
now)
    exec teglon
    ;;
*)
    usage
    ;;
esac
